# ── Ambiente ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_TELEGRAM_USER_IDS=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── IA ────────────────────────────────────────────────────────────────────────
AI_DAILY_CARD_ENABLED=true
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ── Fila de comandos ──────────────────────────────────────────────────────────
BOT_COMMANDS_POLLING_ENABLED=true
BOT_COMMANDS_POLLING_INTERVAL_SECONDS=30
BOT_COMMANDS_BATCH_SIZE=10
BOT_COMMANDS_MAX_RETRIES=3
BOT_COMMANDS_RETRY_DELAY_SECONDS=60
BOT_COMMANDS_PROCESSING_TIMEOUT_SECONDS=900

# ── Rede ──────────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=15
